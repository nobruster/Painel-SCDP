{
  "info": {
    "name": "Portal da Transparência - Viagens",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "chave-api-dados", "type": "string" },
      { "key": "value", "value": "{{api_key}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Viagens por órgão",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/viagens?dataIdaDe=01/09/2026&dataIdaAte=30/09/2026&dataRetornoDe=01/09/2026&dataRetornoAte=30/09/2026&codigoOrgao={{codigo_orgao}}&pagina=1",
          "host": ["{{base_url}}"],
          "path": ["viagens"],
          "query": [
            { "key": "dataIdaDe", "value": "01/09/2026" },
            { "key": "dataIdaAte", "value": "30/09/2026" },
            { "key": "dataRetornoDe", "value": "01/09/2026" },
            { "key": "dataRetornoAte", "value": "30/09/2026" },
            { "key": "codigoOrgao", "value": "{{codigo_orgao}}" },
            { "key": "pagina", "value": "1" }
          ]
        }
      }
    },
    {
      "name": "Viagem por ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/viagens/213639466",
          "host": ["{{base_url}}"],
          "path": ["viagens", "213639466"]
        }
      }
    },
    {
      "name": "Buscar órgão SIAFI",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/orgaos-siafi?descricao=previdencia&pagina=1",
          "host": ["{{base_url}}"],
          "path": ["orgaos-siafi"],
          "query": [
            { "key": "descricao", "value": "previdencia" },
            { "key": "pagina", "value": "1" }
          ]
        }
      }
    }
  ]
}
