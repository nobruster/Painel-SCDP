# Copie para .env e preencha. O .env NUNCA vai para o git.

# API do Portal da Transparencia (chave: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email)
PORTAL_TRANSPARENCIA_API_KEY=
PORTAL_TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
CODIGO_ORGAO=33000

# PostgreSQL (se DATABASE_URL estiver preenchida, ela tem prioridade)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=prefer
DATABASE_URL=

# Schema de cada camada
SCHEMA_STG=staging
SCHEMA_INT=intermediaria
SCHEMA_ANA=analitica
